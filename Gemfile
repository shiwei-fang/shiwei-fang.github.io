# Local preview setup that mirrors what GitHub Pages runs:
#   bundle install            (once)
#   bundle exec jekyll serve  (then open http://localhost:4000)
source "https://rubygems.org"

# Pins Jekyll and every plugin to the exact versions GitHub Pages uses.
gem "github-pages", group: :jekyll_plugins

# Needed by `jekyll serve` on Ruby 3.0+.
gem "webrick"

# Removed from Ruby's default gems in 3.4; Jekyll 3.x still needs them.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
